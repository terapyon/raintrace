{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "raintrace",
  // 固定した wrangler（4.127.1）の workerd が対応する最新の日付。spec 01 §4.11 は「実装した日」
  // （2026-09-10）とするが、それより新しい日付では preview が起動しない。互換性フラグが必要になったときに、
  // wrangler とあわせて進める
  "compatibility_date": "2026-09-04",
  "workers_dev": true,
  "preview_urls": true,
  // 静的配信のみ。assets.directory は @cloudflare/vite-plugin がビルドの出力先に合わせて決める
  "assets": {
    "not_found_handling": "single-page-application"
  },
  "env": {
    // ステージング（R01-3）。ビルド時に CLOUDFLARE_ENV=staging を渡すと、この名前の Worker 向けに出力される
    "staging": {
      "name": "raintrace-staging"
    }
  }
}
