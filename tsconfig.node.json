{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsc/node.tsbuildinfo",
    // DOM は、E2E の page.evaluate の中で window などを参照するため。
    // E2E が src/ui/strings.ts を import するので、strings.ts は app とこのプロジェクトの両方で検査される（意図どおり）
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["vite.config.ts", "vitest.config.ts", "playwright.config.ts", "tests/e2e/**/*.ts"],
  // tests/e2e/simulation.spec.ts が src/map 経由で shared/protocol・simulation の型に届く（Task 13 fix
  // round 1）。参照しないと、simulation のソースをこのプロジェクトの設定（noUncheckedIndexedAccess: true）
  // で検査してしまう（tsconfig.core.json の同じ注記のとおり）
  "references": [{ "path": "./tsconfig.sim.json" }, { "path": "./tsconfig.core.json" }]
}
