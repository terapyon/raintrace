{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsc/scripts.tsbuildinfo",
    // Node で直接実行するスクリプト（scripts/bench-engine.ts）。DOM の lib を持たない
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": ["scripts/**/*.ts"],
  // scripts/bench-engine.ts は src/simulation を import する。参照しないと、simulation のソースを
  // このプロジェクトの設定（noUncheckedIndexedAccess: true）で検査してしまう（tech-spec §10.3）
  "references": [{ "path": "./tsconfig.sim.json" }]
}
