{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.tmp/tsc/worker.tsbuildinfo",
    // DOM と WebWorker の lib を同じコンパイル単位に置かない（tech-spec §10.3）
    "lib": ["ES2023", "WebWorker"]
  },
  "include": ["src/workers", "src/perf-env.d.ts"],
  "exclude": ["src/**/*.test.ts"],
  "references": [{ "path": "./tsconfig.sim.json" }, { "path": "./tsconfig.core.json" }]
}
