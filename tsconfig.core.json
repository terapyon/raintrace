{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "node_modules/.tmp/tsc/core",
    "tsBuildInfoFile": "node_modules/.tmp/tsc/core.tsbuildinfo",
    "lib": ["ES2023"]
  },
  "include": ["src/dem", "src/shared"],
  "exclude": ["src/**/*.test.ts"],
  // shared は simulation の型を import する（02 以降）。参照しないと、simulation のソースを
  // このプロジェクトの設定（noUncheckedIndexedAccess: true）で検査してしまう（tech-spec §10.3）
  "references": [{ "path": "./tsconfig.sim.json" }]
}
