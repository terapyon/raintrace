{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "node_modules/.tmp/tsc/core",
    "tsBuildInfoFile": "node_modules/.tmp/tsc/core.tsbuildinfo",
    "lib": ["ES2023"],
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true
  },
  "include": ["src/dem", "src/shared"],
  "exclude": ["src/**/*.test.ts"]
}
