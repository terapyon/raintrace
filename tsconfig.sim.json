{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "node_modules/.tmp/tsc/sim",
    "tsBuildInfoFile": "node_modules/.tmp/tsc/sim.tsbuildinfo",
    "lib": ["ES2023"],
    // src/simulation だけは無効にする（tech-spec §10.2）
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/simulation"],
  "exclude": ["src/**/*.test.ts"]
}
